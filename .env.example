# ============ DeepSeek 大模型接入（各审核环节的 AI 预审） ============
# 申请 API Key：https://platform.deepseek.com/
# 使用方式：复制本文件为 .env 并填入真实 Key
# 注意：.env 已被 git 忽略；请勿把真实密钥写进本文件（本文件会被提交）
DEEPSEEK_API_KEY=

# 可选：接口地址，默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=

# 可选：模型名，默认 deepseek-chat（也可用 deepseek-reasoner）
DEEPSEEK_MODEL=

# ============ 本地 SQLite（可选） ============
# 默认使用 ./data/app.db
DATABASE_FILE=
